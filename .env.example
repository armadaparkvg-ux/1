# === Общие ===
DATABASE_URL=sqlite:///./data/publications.db
LOG_LEVEL=INFO
PUBLIC_VIDEO_BASE_URL=
# Публичный HTTPS URL, по которому Instagram/TikTok могут скачать видео
# (обязателен для Instagram Reels — Graph API принимает только video_url)

# === VK ===
VK_ACCESS_TOKEN=
VK_GROUP_ID=
VK_API_VERSION=5.199

# === YouTube Data API v3 ===
YOUTUBE_CLIENT_SECRETS_FILE=./secrets/youtube_client_secrets.json
YOUTUBE_TOKEN_FILE=./secrets/youtube_token.json
YOUTUBE_CATEGORY_ID=22
YOUTUBE_DEFAULT_PRIVACY=public

# === Instagram Graph API (Meta) ===
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
INSTAGRAM_API_VERSION=v21.0

# === TikTok Content Posting API ===
TIKTOK_ACCESS_TOKEN=
TIKTOK_OPEN_ID=
TIKTOK_PRIVACY_LEVEL=PUBLIC_TO_EVERYONE
# До аудита приложения используйте SELF_ONLY
TIKTOK_CHUNK_SIZE=5242880

# === Scheduler ===
SCHEDULER_POLL_INTERVAL_SECONDS=30
SCHEDULER_TIMEZONE=Europe/Moscow
